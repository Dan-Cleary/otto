{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install --no-audit --no-fund && npm run widget:build && cd app && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "app/dist",
  "installCommand": "true",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": false },
    { "source": "/app/(.*)", "destination": "/", "permanent": false },
    { "source": "/dashboard", "destination": "/", "permanent": false },
    { "source": "/dashboard/(.*)", "destination": "/", "permanent": false },
    { "source": "/login", "destination": "/", "permanent": false },
    { "source": "/signup", "destination": "/", "permanent": false },
    { "source": "/docs/(.*)", "destination": "/", "permanent": false },
    { "source": "/auth/github/callback", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(otto|_brand)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
